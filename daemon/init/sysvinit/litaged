#!/bin/sh
### BEGIN INIT INFO
# Provides:          litaged
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Lenovo power automation daemon
### END INIT INFO
# Litage daemon — SysVinit (Debian/Devuan/Gentoo-compat)
case "$1" in
  start) /usr/local/bin/litaged --daemon ;;
  stop) pkill -f '/usr/local/bin/litaged' ;;
  restart) "$0" stop; sleep 1; "$0" start ;;
  status) pgrep -af litaged ;;
  *) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
